rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Events collection
    match /events/{eventId} {
      // Public visitors can only read published events
      allow read: if resource.data.published == true;
      // Authenticated admins can read ALL events (including drafts)
      allow read: if request.auth != null;
      // Only authenticated admins can create/update/delete
      allow create: if request.auth != null
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.flyerType in ['pdf', 'image', 'none']
        && request.resource.data.published is bool;
      allow update: if request.auth != null
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.flyerType in ['pdf', 'image', 'none']
        && request.resource.data.published is bool;
      allow delete: if request.auth != null;
    }

    // Global site settings (Zoom URL, etc.)
    match /settings/{doc} {
      // Anyone can read settings (needed for homepage Zoom button)
      allow read: if true;
      // Only authenticated admins can modify
      allow write: if request.auth != null;
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
